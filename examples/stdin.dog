fn foo(f) {
    let p = pipe(-1);
    spawn { p <- f(); };
    return p;
}

disp "Enter your name: ";

select {
    let result = <-foo(fn() -> stdin.read_line()) {
        disp "Hello, " + result.str().trim() + "!";
    }

    <-foo(fn() { sleep(5000); return null; }) {
        disp "Goodbye!";
    }
}
