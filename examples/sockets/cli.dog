struct ReadLineWithTimeout {
    fn init(conn, timeout_ms) {
        self.conn = conn;
        self.timeout_ms = timeout_ms;

        self.on_success = null;
        self.on_timeout = null;

        self.completed = false;

        self.read_pipe = pipe(0);
        self.timeout_pipe = pipe(0);

        spawn {
            let line = self.conn.read_line();
            if !self.completed {
                self.completed = true;
                self.read_pipe <- line;
            }
        };

        spawn {
            sleep(self.timeout_ms);
            if !self.completed {
                self.completed = true;
                self.timeout_pipe <- true;
            }
        };
    }

    fn on_success(callback) {
        self.on_success = callback;
        return self;
    }

    fn on_timeout(callback) {
        self.on_timeout = callback;
        return self;
    }

    fn wait() {
        if self.completed {
            return;
        }

        select {
            let line = <-self.read_pipe {
                if !self.completed {
                    self.completed = true;
                    if self.on_success != null {
                        self.on_success(line);
                    }
                }
            }
            <-self.timeout_pipe {
                if !self.completed {
                    self.completed = true;
                    if self.on_timeout != null {
                        self.on_timeout();
                    }
                }
            }
        }
    }
}

let sock1 = connect("tcp", {
    host: "127.0.0.1",
    port: 8080
});

disp "connected to server " + sock1;

sock1.write("Hello from client 1\n");

let reader = ReadLineWithTimeout(sock1, 5000)
    .on_success(fn(line) { 
        if line == null {
            disp "Connection closed by server.";
        } else {
            disp "Received from server: " + line.str().trim();
        }
    })
    .on_timeout(fn() {
        disp "Read operation timed out!";
    })
    .wait();