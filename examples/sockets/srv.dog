
fn handleConnection(conn) {
    let request = conn.read_line();
    if (request == null) {
        disp "connection closed by client";
        return;
    }

    request = request.str().trim();

    disp "request from client: " + request;
    conn.write("ACK for `" + request + "`\n");
    conn.close_();
}

let listener = listen("tcp", {
    port: 8080
});

disp "new listener " + listener;

while true {
    let conn = listener.accept();
    disp "new connection " + conn;

    spawn {
        handleConnection(conn);
    };
}