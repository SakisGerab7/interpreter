fn main() {
    let t2;

    let t1 = spawn {
        let acc = 0;

        fn work(tid) {
            let n = (tid == 1) ? 5 : 8;

            for let i = 0; i < n; i++ {
                acc++;
                disp ((tid == 1) ? "first" : "second") + " thread";
                disp ((tid == 1) ? "first" : "second") + " thread";
                sleep(1000);
            }
        }

        t2 = spawn {
            let tid = thread_id();
            work(tid);
            return "thread " + tid + " got acc up to " + acc;
        };

        let tid = thread_id();
        work(tid);
        return "thread " + tid + " got acc up to " + acc;
    };

    disp t1.join();
    disp t2.join();

    disp "this is the end";
}

main();

return 1;