// Matrix multiplication benchmark (arrays)

let n = 180;

let a = [];
let b = [];
let c = [];

srand(42);

for let i = 0; i < n; i++ {
    let row_a = [];
    let row_b = [];
    let row_c = [];
    for let j = 0; j < n; j++ {
        row_a.push(randint(0, 100));
        row_b.push(randint(0, 100));
        row_c.push(0);
    }
    a.push(row_a);
    b.push(row_b);
    c.push(row_c);
}

disp "Starting matrix multiplication...";

let start = clock();
for let i = 0; i < n; i = i + 1 {
    let row_a = a[i];
    for let k = 0; k < n; k = k + 1 {
        let aik = row_a[k];
        let row_c = c[i];
        let row_b = b[k];
        for let j = 0; j < n; j = j + 1 {
            row_c[j] = row_c[j] + aik * row_b[j];
        }
    }
}
let elapsed = clock() - start;

disp "Elapsed time: " + elapsed + " seconds";
