// N-body simulation benchmark (structs + arrays)

struct Body {
    fn init(x, y, z, vx, vy, vz, m) {
        self.x = x; self.y = y; self.z = z;
        self.vx = vx; self.vy = vy; self.vz = vz;
        self.m = m;
    }
}

let n = 256;
let steps = 10;
let dt = 0.01;
let seed = 7;

let bodies = [];
for let i = 0; i < n; i++ {
    let x = randint(0, 1000) / 100.0;
    let y = randint(0, 1000) / 100.0;
    let z = randint(0, 1000) / 100.0;
    let vx = randint(0, 1000) / 10000.0;
    let vy = randint(0, 1000) / 10000.0;
    let vz = randint(0, 1000) / 10000.0;
    let m = randint(0, 1000) / 100.0 + 1.0;

    bodies.push(Body(x, y, z, vx, vy, vz, m));
}

let start = clock();
for let step = 0; step < steps; step++ {
    // update velocities
    for let i = 0; i < n; i++ {
        let bi = bodies[i];
        let ax = 0.0; let ay = 0.0; let az = 0.0;
        for let j = 0; j < n; j++ {
            if i != j {
                let bj = bodies[j];
                let dx = bj.x - bi.x;
                let dy = bj.y - bi.y;
                let dz = bj.z - bi.z;
                let dist2 = dx*dx + dy*dy + dz*dz + 0.01;
                let inv = 1.0 / (dist2 * sqrt(dist2));
                let s = bj.m * inv;
                ax += dx * s;
                ay += dy * s;
                az += dz * s;
            }
        }
        bi.vx += ax * dt;
        bi.vy += ay * dt;
        bi.vz += az * dt;
    }

    // update positions
    for let i = 0; i < n; i++ {
        let b = bodies[i];
        b.x += b.vx * dt;
        b.y += b.vy * dt;
        b.z += b.vz * dt;
    }
}
let elapsed = clock() - start;

let checksum = 0.0;
for let i = 0; i < n; i++ {
    let b = bodies[i];
    checksum += b.x + b.y + b.z + b.vx + b.vy + b.vz;
}

disp "sum=" + checksum;
disp "secs=" + elapsed;
