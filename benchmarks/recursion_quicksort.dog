fn swap(arr, i, j) {
    let tmp = arr[i];
    arr[i] = arr[j];
    arr[j] = tmp;
}

fn partition(arr, left, right) {
    let pivot = arr[int((left + right) / 2)];
    let i = left;
    let j = right;
    while i <= j {
        while arr[i] < pivot { i++; }
        while arr[j] > pivot { j--; }
        if i <= j {
            swap(arr, i, j);
            i++;
            j--;
        }
    }

    return i;
}

fn quicksort(arr) {
    fn quicksort_rec(arr, left, right) {
        if left >= right { return; }
        let index = partition(arr, left, right);
        if left < index - 1 { quicksort_rec(arr, left, index - 1); }
        if index < right { quicksort_rec(arr, index, right); }
    }

    return quicksort_rec(arr, 0, len(arr) - 1);
}

fn read_numbers_from_binary_file(path) {
    let file = open(path, "r");
    let arr = [];
    let reading = true;
    while reading {
        let bytes = file.read(4);
        if len(bytes) == 4 {
            let num = unpack(bytes, "i32");
            arr.push(num);
        } else {
            reading = false;
        }
    }

    return arr;
}

fn is_sorted(arr) {
    for let i = 0; i < len(arr) - 1; i++ {
        if arr[i] > arr[i + 1] {
            return false;
        }
    }

    return true;
}

let args = cli_args();
if len(args) != 2 {
    return 1;
}

let arr = read_numbers_from_binary_file("benchmarks/numbers_" + args[1] + ".bin");

let start = clock();
quicksort(arr);
let elapsed = clock() - start;

disp "size   = " + len(arr);
disp "sorted = " + is_sorted(arr);
disp "secs   = " + elapsed;
